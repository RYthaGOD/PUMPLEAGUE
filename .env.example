# PumpLeague Environment Configuration
# Copy to .env and fill in your values

# Solana RPC
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Arena Wallet (for payouts)
# Generate with: node utils/generate-wallet.js
ARENA_WALLET_SECRET=your_base58_secret_key_here

# PumpPortal API (required for fee claims)
# Get from: https://pumpportal.fun
PUMPPORTAL_API_KEY=YOUR_PUMPPORTAL_API_KEY

# Twitter API (optional - for announcements)
# Get these from https://developer.twitter.com/en/portal/projects
TWITTER_ENABLED=false
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Gemini AI (Google)
# Get from: https://aistudio.google.com/app/apikey
AI_ENABLED=true
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
AI_AUTOPILOT_MODE=SEMI_AUTO
AI_MAX_TWEETS_PER_HOUR=3
